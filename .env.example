# Copiar a .env antes de ejecutar: cp .env.example .env
PORT=3000
JWT_SECRET=cambiar_por_un_secreto_seguro
# DB_PATH se define por servicio en docker-compose.yaml (una base por servicio).

PROJECTS_SOAP_URL=http://projects-service:3001/soap/projects
PROJECTS_SOAP_TIMEOUT_MS=2000

# Circuit Breaker de Tareas -> Proyectos
PROJECTS_CB_TIMEOUT_MS=2500
PROJECTS_CB_VOLUME_THRESHOLD=5
PROJECTS_CB_ERROR_THRESHOLD_PERCENTAGE=50
PROJECTS_CB_RESET_TIMEOUT_MS=10000
PROJECTS_CB_ROLLING_COUNT_TIMEOUT_MS=10000
